{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "excludeFiles": [
        "**/*.dist-info/licenses/**",
        "dataset/**",
        "app/static/annotated/**",
        "samples/**",
        "training_results/**",
        "models/*.pt",
        "pothole_detection.ipynb",
        "roadsentinel.db",
        "structure.txt",
        "train.py"
      ]
    },
    "dashboard": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "excludeFiles": [
        "**/*.dist-info/licenses/**",
        "dataset/**",
        "app/static/annotated/**",
        "samples/**",
        "training_results/**",
        "models/*.pt",
        "pothole_detection.ipynb",
        "roadsentinel.db",
        "structure.txt",
        "train.py"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
